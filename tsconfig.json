{
    "extends": "./.nuxt/tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "typeRoots": ["./app/types"]
    },
    "include": [
        ".nuxt/nuxt.d.ts",
        ".nuxt/nuxt.node.d.ts",
        "nuxt.config.*",
        "app/**/*",
        "server/**/*",
        "shared/**/*"
    ]
}
